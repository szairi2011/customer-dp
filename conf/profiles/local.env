# Profil « local » : poste de développement, PySpark installé par uv, aucun cluster.
# Fichier sourcé par bash (scripts/_env.sh) : syntaxe VARIABLE="valeur".
LAUNCHER=python                      # python = exécution directe ; spark-submit = soumission cluster
CUSTOMER_DP_SPARK_MASTER="local[2]"
CUSTOMER_DP_INPUT_ROOT="file://${PROJECT_ROOT}/data/sample"
CUSTOMER_DP_OUTPUT_ROOT="file://${PROJECT_ROOT}/.local/output"
CUSTOMER_DP_HIVE_ENABLED=false
KERBEROS_MODE=none
