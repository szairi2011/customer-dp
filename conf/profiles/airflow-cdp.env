# Profil Airflow 2.11 de la plateforme CDP (VM Airflow). Valeurs reprises de alm-dp/conf/airflow.yaml.
AIRFLOW_RUNTIME_PROFILE=cdp-dev      # profil d'exécution Spark utilisé par les tâches du DAG
AIRFLOW_HOST=172.28.3.226
AIRFLOW_PORT=22
AIRFLOW_USER=""                      # vide : utilisateur SSH courant
AIRFLOW_DAGS_DIR=/root/airflow/dags/customer-dp
AIRFLOW_RELEASE_ROOT=/root/airflow/dags/customer-dp/releases   # environnement Python extrait (mode client)
AIRFLOW_CONN_ID=spark3_default
AIRFLOW_SUBMIT_MODE=provider         # provider = SparkSubmitOperator ; bash = spark-submit via BashOperator
DAG_ID=customer_dp
DAG_SCHEDULE="0 22 * * 1-5"          # fin de journée, jours ouvrés ; "None" = déclenchement manuel seul
DAG_START_DATE=2026-03-01
DAG_RETRIES=1
DAG_RETRY_DELAY_MINUTES=5
DAG_TASK_TIMEOUT_MINUTES=120
DAG_PAUSED_ON_CREATION=true          # le DAG est créé en pause : déclencher manuellement avant d'activer
AIRFLOW_KERBEROS_MODE=keytab         # none | keytab
AIRFLOW_KERBEROS_KEYTAB=/etc/airflow/dags.keytab
AIRFLOW_KERBEROS_PRINCIPAL="svc.dags/cdp-namenode-02-hors-prod.bank-sud.tn@BANK-SUD.TN"
