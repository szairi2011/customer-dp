# Profil « hadoop » : Hadoop open source. MODÈLE : aucune valeur d'infrastructure n'est inventée.
# Renseignez les variables marquées OBLIGATOIRE, ou créez conf/profiles/hadoop.local.env
# (ignoré par Git) pour les valeurs propres à votre poste.
LAUNCHER=spark-submit
SPARK_SUBMIT=""                      # OBLIGATOIRE : ex. "${SPARK_HOME}/bin/spark-submit"
SPARK_MASTER=yarn
DEPLOY_MODE=client                   # client | cluster
PYTHON_DRIVER=""                     # OBLIGATOIRE : Python 3.8 du driver
PYTHON_EXECUTOR=""                   # OBLIGATOIRE : Python 3.8 présent sur les nœuds (ou environnement packagé)
HADOOP_CONF_DIR=""                   # OBLIGATOIRE : ex. /etc/hadoop/conf
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=4g
SPARK_EXECUTOR_CORES=2
SPARK_NUM_EXECUTORS=2
SPARK_JARS=""                        # aucun jar HWC hors CDP
SPARK_CONF="
spark.sql.shuffle.partitions=40
spark.sql.adaptive.enabled=true
spark.sql.adaptive.coalescePartitions.enabled=true
"
KERBEROS_MODE=none                   # none | ticket | keytab (keytab : KERBEROS_PRINCIPAL et KERBEROS_KEYTAB)
KERBEROS_PRINCIPAL=""
KERBEROS_KEYTAB=""

HDFS_ARTIFACT_ROOT=""                # OBLIGATOIRE : ex. /user/<utilisateur>/data-products
CUSTOMER_DP_INPUT_ROOT=""            # OBLIGATOIRE : dossier HDFS des CSV bruts
CUSTOMER_DP_OUTPUT_ROOT=""           # OBLIGATOIRE : racine HDFS des tables Parquet
CUSTOMER_DP_HIVE_ENABLED=false       # true si un metastore Hive est disponible
CUSTOMER_DP_DATABASE=customer_dp
