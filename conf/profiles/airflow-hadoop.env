# Profil Airflow pour un environnement Hadoop open source. MODÈLE : renseignez les valeurs OBLIGATOIRE.
AIRFLOW_RUNTIME_PROFILE=hadoop
AIRFLOW_HOST=""                      # OBLIGATOIRE (sauf --mode local)
AIRFLOW_PORT=22
AIRFLOW_USER=""
AIRFLOW_DAGS_DIR=""                  # OBLIGATOIRE : dossier surveillé par Airflow
AIRFLOW_RELEASE_ROOT=""              # OBLIGATOIRE en mode client : hors du dossier DAG de préférence
AIRFLOW_CONN_ID=""                   # OBLIGATOIRE en mode provider : connexion Spark existante
AIRFLOW_SUBMIT_MODE=bash             # provider | bash (bash : aucun provider requis)
DAG_ID=customer_dp
DAG_SCHEDULE="None"
DAG_START_DATE=2026-03-01
DAG_RETRIES=1
DAG_RETRY_DELAY_MINUTES=5
DAG_TASK_TIMEOUT_MINUTES=120
DAG_PAUSED_ON_CREATION=true
AIRFLOW_KERBEROS_MODE=none
AIRFLOW_KERBEROS_KEYTAB=""
AIRFLOW_KERBEROS_PRINCIPAL=""
