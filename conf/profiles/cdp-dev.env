# Profil « cdp-dev » : gateway CDP (Spark 3.3.2 / YARN / Kerberos). Valeurs reprises de alm-dp/conf/cdp.yaml.
# HDFS_USER vaut $PLATFORM_HDFS_USER, à défaut l'utilisateur courant.
LAUNCHER=spark-submit
SPARK_SUBMIT=/opt/cloudera/parcels/SPARK3/bin/spark3-submit
SPARK_MASTER=yarn
DEPLOY_MODE=client
PYTHON_DRIVER=/usr/bin/python3.8
PYTHON_EXECUTOR=/usr/bin/python3.8
HADOOP_CONF_DIR=/etc/hadoop/conf
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=4g
SPARK_EXECUTOR_CORES=2
SPARK_NUM_EXECUTORS=2
SPARK_JARS="/opt/cloudera/parcels/SPARK3-3.3.2.3.3.7191000.0-78-1.p0.56279928/lib/spark3/hwc_for_spark3/hive-warehouse-connector-spark3-assembly-1.0.0.3.3.7191000.0-78.jar"
# Une option --conf par ligne.
SPARK_CONF="
spark.hadoop.hive.exec.dynamic.partition.mode=nonstrict
spark.hadoop.hadoop.security.authentication=kerberos
spark.sql.shuffle.partitions=40
spark.sql.adaptive.enabled=true
spark.sql.adaptive.coalescePartitions.enabled=true
spark.sql.adaptive.skewJoin.enabled=true
spark.yarn.executor.memoryOverhead=1g
spark.network.timeout=300s
spark.rpc.askTimeout=300s
spark.executor.heartbeatInterval=60s
"
KERBEROS_MODE=ticket                 # ticket Kerberos de la gateway (klist) ; aucun secret ici

HDFS_ARTIFACT_ROOT="/user/${HDFS_USER}/data-products"   # artefacts : <racine>/customer-dp/<version>/
CUSTOMER_DP_INPUT_ROOT="/user/${HDFS_USER}/data-products/customer-dp/input"
CUSTOMER_DP_OUTPUT_ROOT="/user/${HDFS_USER}/data-products/customer-dp/output"
CUSTOMER_DP_HIVE_ENABLED=true
CUSTOMER_DP_DATABASE=customer_dp_dev
